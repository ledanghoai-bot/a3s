+        name=t["name"], arguments=json.dumps(t["args"], ensure_ascii=False)))
+        for i, t in enumerate(tools or [])] or None
+    return types.SimpleNamespace(content=content, tool_calls=tcs)
+
+
+def _resp(msg, finish):
