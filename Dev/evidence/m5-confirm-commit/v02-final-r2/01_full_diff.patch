+--   DROP INDEX IF EXISTS messages_dedupe_key_uidx;
+--   ALTER TABLE messages DROP COLUMN IF EXISTS dedupe_key;
+--   ALTER TABLE order_intents DROP COLUMN IF EXISTS summary_content_hash;
