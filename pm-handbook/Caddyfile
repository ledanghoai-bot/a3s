# Caddyfile BÊN TRONG container pm_site: chỉ phục vụ tệp tĩnh đã build ở /srv trên cổng 80.
# HTTPS và tên miền do Caddy chính (docker/caddy/Caddyfile, block {$PM_DOMAIN}) đảm nhiệm và
# reverse_proxy tới đây. Container này KHÔNG mở cổng ra host.
:80 {
	root * /srv
	encode gzip
	file_server

	# Site tĩnh, không JavaScript: khóa CSP chặt.
	header {
		Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Robots-Tag "noindex"
		-Server
	}

	handle_errors {
		@notfound expression {http.error.status_code} == 404
		handle @notfound {
			rewrite * /404.html
			file_server
		}
	}
}
